# העתק לקובץ .env באותה תיקייה (bridge/), על השרת הפיזי בלבד. לא עולה ל-git.
#
# הקובץ הזה חי רק כאן — על השרת שבו נמצא ה-SQL Server של סיגמא, ברשת המקומית.
# הוא אף פעם לא נשלח לענן. מה שכן נשלח לענן הוא רק הנתונים המנורמלים (מספר
# הזמנה, לקוח, שורות וכו') דרך חיבור HTTPS יוצא ל-backend.

# ---------- SQL Server מקומי של סיגמא (קריאה בלבד) ----------
SIGMA_SQL_SERVER=localhost
# אם ה-SQL Server רץ עם Instance בשם (למשל SQLSIGMA — בדקו בקובץ ה-INI של
# סיגמא עצמו, שדה SQLInstance), למלא את זה ולהשאיר את SIGMA_SQL_PORT ריק —
# הפורט יימצא אוטומטית. אם אין Instance (התקנת ברירת מחדל), להשאיר ריק
# ולהשתמש ב-SIGMA_SQL_PORT (בדרך כלל 1433).
SIGMA_SQL_INSTANCE=
SIGMA_SQL_PORT=1433
SIGMA_SQL_DATABASE=
SIGMA_SQL_USER=
SIGMA_SQL_PASSWORD=
SIGMA_SQL_ENCRYPT=true
SIGMA_SQL_TRUST_CERT=true
SIGMA_COMPANY_ID=3
# ריק = לסנכרן את כל הסדרות (sidra) של החברה הזו (למשל גם 0 וגם 99).
# אם רוצים להגביל לרשימה ספציפית: SIGMA_SIDRAS=0,99
SIGMA_SIDRAS=

# ---------- לאן דוחפים ----------
# כתובת ה-backend בענן + הנתיב הקבוע לקליטת הזמנות.
# ברירת המחדל למטה מתאימה לפריסת Render. בפריסת Cloudways (ר' README.md
# הראשי, סעיף "פריסה — Cloudways") ה-backend לרוב נגיש רק דרך ה-PHP shim —
# אז הכתובת הנכונה היא בפורמט:
#   https://<domain>/api.php?_p=/admin/sigma-sync
# ולא /api/admin/sigma-sync הרגיל, אחרת הבקשות מה-bridge לא מגיעות בכלל
# לתהליך ה-Node (נראה כאילו הכול "מחובר" אבל בלי הזמנות בכלל).
BRIDGE_TARGET_URL=https://aladin-backend-6vdq.onrender.com/api/admin/sigma-sync

# סוד משותף חייב להיות זהה גם כאן וגם במשתני הסביבה של ה-backend בענן
# (SIGMA_BRIDGE_SECRET — ב-Render דרך ה-Dashboard, ב-Cloudways דרך backend/.env
# על השרת עצמו + הפעלה מחדש של התהליך). כל מחרוזת אקראית ארוכה.
SIGMA_BRIDGE_SECRET=

# כל כמה זמן לסנכרן (מילישניות). ברירת המחדל תואמת את המלצת האפיון (30-60 שניות)
SYNC_INTERVAL_MS=45000

# שעות פעילות (שעון המחשב המקומי) — מסתנכרן רק בין השעות האלה, גם אם השירות
# עצמו רץ ברקע 24/7. ברירת מחדל: 8:00 עד 17:00.
SYNC_ACTIVE_HOUR_START=8
SYNC_ACTIVE_HOUR_END=17

# מיפוי פריט->ספק (pritim.FLinkToMaazni -> maazni.name) — קטלוג שמשתנה לאט,
# לא כפוף לשעות פעילות. ברירת מחדל: כל 6 שעות (21600000 מילישניות).
SUPPLIER_SYNC_INTERVAL_MS=21600000
