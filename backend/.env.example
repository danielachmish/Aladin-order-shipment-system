# העתק לקובץ .env (לא ל-git!) ומלא את הערכים כדי לחבר Sigma ו-UPS אמיתיים.
# כל עוד .env לא קיים (או ריק), המערכת ממשיכה לעבוד עם ה-MOCK של הפיתוח.

# ---------- Sigma (SQL Server, קריאה בלבד) ----------
# לקבל ממחשוב מקומי: משתמש SQL עם הרשאות SELECT בלבד על azmana_index/azmanot/
# maazni/pritim/SPU_QPrintAzmana (סעיף 8.3, 13), וכתובת השרת ברשת החברה.
# אם השרת ברשת פנימית בלבד — Sigma Bridge צריך לרוץ כשירות בתוך אותה רשת
# (סעיף 7: "Sigma Bridge כשירות Windows"), לא על מכונת הפיתוח הזו.
SIGMA_SQL_SERVER=
SIGMA_SQL_PORT=1433
SIGMA_SQL_DATABASE=
SIGMA_SQL_USER=
SIGMA_SQL_PASSWORD=
SIGMA_SQL_ENCRYPT=true
SIGMA_SQL_TRUST_CERT=false
SIGMA_COMPANY_ID=3
SIGMA_SIDRA=0
SIGMA_POLL_INTERVAL_MS=45000

# ---------- UPS ----------
# Webhook (הערוץ הראשי, סעיף 9.2): לפנות אל hd@ups.co.il עם מספר לקוח, איש קשר
# ותפקיד, כתובת ה-Webhook הציבורית (HTTPS, .../api/webhooks/ups), ודרישת האימות.
# UPS_WEBHOOK_BEARER_SECRET הוא הסוד שסוכם מולם לאימות הבקשות הנכנסות.
UPS_WEBHOOK_BEARER_SECRET=

# API משלים (סעיף 9.4, לא חובה להתחלה) — OAuth client credentials מ-UPS Developer Portal
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_API_BASE=https://onlinetools.ups.com/api
UPS_RECONCILE_INTERVAL_MS=3600000

# ---------- כללי ----------
PORT=4310
JWT_SECRET=
